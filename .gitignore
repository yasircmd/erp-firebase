# Firebase CLI / emulator artifacts
.firebase/
*-debug.log

# Dependencies
node_modules/

# Credentials file written by google-github-actions/auth in CI (never commit)
gha-creds-*.json

# Built at deploy by tools/build-styles.sh (docs/modules/PWA.md)
public/css/

# Built at each functions deploy by tools/build-lazy-exports.js (docs/modules/PERFORMANCE.md)
functions/lazy-exports.json

# Test-only secrets for the functions emulator (TASK_MAIL_KEY): never committed
functions/.secret.local

# The item-catalogue measurement's last output (functions/test/perf/items50k.perf.js)
functions/test/perf/*.last.json
